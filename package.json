{
    "name": "my-fullstack-app",
    "version": "1.0.0",
    "scripts": {
        "start": "cd backend && yarn start",
        "build": "cd frontend && npm run build",
        "install-all": "npm install && cd frontend && npm install && cd ../backend && npm install && cd ../mobile && npm install",
        "mobile:start": "cd mobile && npm start",
        "mobile:ios": "cd mobile && npx react-native run-ios",
        "mobile:android": "cd mobile && npx react-native run-android"
    }
}
